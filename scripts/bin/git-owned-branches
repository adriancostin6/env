#!/usr/bin/env bash

main() {
	echo "Enter owner name (First, Last):"
	read name

	git for-each-ref \
		--sort=committerdate                                            \
		--format='%(committerdate) %09 %(authorname) %09 %(refname)'    \
		refs/remotes | grep -v "[S-Z]-[0-9][0-9][0-9][0-9]\.[0-9][0-9]" \
	| grep refs/remotes/origin/                                         \
	| grep "$name"
}

main
