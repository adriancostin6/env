#!/usr/bin/env bash

usage() {
    printf "%s" "\
usage: gh-workflow-run [options...]
options:
    --name workflow-name
    --branch branch-name
    --json: start workflow using json file
    --interactive: select workflow parameters interactively
    --dump-json: dump interactive config to a json file
    --help
"
}

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --name|-n)
            _ARG_WORKFLOW_PATH="$2"
            shift
            shift
            ;;
        --branch|-b)
            _ARGbranch="$2"
            shift
            shift
            ;;
        --json)
            _ARG_JSON="$2"
            shift
            shift
            ;;
        --interactive|-i)
            _ARG_INTERACTIVE=1
            shift
            ;;
        --last|-l)
            _ARG_LAST=1
            shift
            ;;
        --dump-json)
            _ARG_DUMP_JSON=1
            _JSON_DUMP_LOCATION="$HOME/.local/state/gh_workflow_run"
            mkdir -p "$_JSON_DUMP_LOCATION"
            shift
            ;;
        --bypass)
            _ARG_BYPASS=1
            shift
            _ARGS_BYPASS=("$@")
            break
            ;;
        --help)
            _ARG_HELP=1
            shift
            ;;
        *)
            shift
            ;;
        esac
    done
}

main() {
    if [[ $# -eq 0 ]]; then 
        usage
        exit 1
    fi

    parse_args "$@"

    if [[ $_ARG_HELP ]]; then
        usage
        exit
    fi

    if [[ $_ARG_BYPASS ]]; then 
        gh workflow run "${_ARGS_BYPASS[@]}" 
        exit
    fi

    if [[ $_ARG_JSON ]] && [[ $_ARG_INTERACTIVE ]]; then
        echo "Cannot run with JSON file and interactive mode at the same time."
        exit 1
    fi

    local branch branch_no_slash
    branch="${_ARG_BRANCH:-$(git branch --show-current)}"
    branch_no_slash=${branch//\//}

    local workflow_abspath
    workflow_abspath="$_ARG_WORKFLOW_PATH"

    if [[ -z "$workflow_abspath" ]]; then
        local root
        root=$(git rev-parse --show-toplevel)

        local workflow_relative 
        workflow_relative="$(gh workflow list --json path --jq '.[].path' | fzf)"
        workflow_abspath="$root/$workflow_relative_path"

            if [[ -z "$workflow_abspath" ]]; then 
            echo "Can't get workflow name."
            exit 1
        fi
    fi

    if [[ $_ARG_LAST ]]; then
        gh_workflow_run "$(basename $workflow_abspath)" --ref "$branch_no_slash" --json "$GH_WORKFLOW_RUN_LAST_WORKFLOW"
        exit
    fi

    if [[ $_ARG_INTERACTIVE ]]; then
        _JSON="$(gh_workflow_json "$workflow_abspath" )"
        if [[ $_ARG_DUMP_JSON ]]; then
        _JSON_DUMP_FILE="$(basename "$workflow_abspath").$branch_no_slash.json"
        echo "Dumping JSON configuration to $_JSON_DUMP_LOCATION/$_JSON_DUMP_FILE"
        printf "%s" "$_JSON" > "$_JSON_DUMP_LOCATION/$_JSON_DUMP_FILE"
        _WORKFLOW_LOCATION="$_JSON_DUMP_LOCATION/$_JSON_DUMP_FILE"
        gh workflow run "$(basename $workflow_abspath)" --ref "$branch_no_slash" --json  < "$_WORKFLOW_LOCATION"
        export GH_WORKFLOW_RUN_LAST_WORKFLOW="$_WORKFLOW_LOCATION"
        fi
        gh workflow run "$(basename $workflow_abspath)" --ref "$branch_no_slash" --json  <<< "$_JSON"
        exit 0
    fi

    gh workflow run "$(basename $workflow_abspath)" --ref "$branch_no_slash" --json < "$_ARG_JSON"
}

main "$@"
